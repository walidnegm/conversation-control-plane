  NeighborCells:
    CELL-DAL16-C
    CELL-DAL18-A

inspect governed SoT projection:
  serving-cell load        = HIGH
    ← RAN performance / telemetry SoR
  interference indicator   = DEGRADED
    ← RAN measurement / assurance source
  neighbor load            = LOW / MEDIUM
    ← neighboring-cell telemetry
  neighbor relation        = VALID
    ← RAN configuration / inventory SoR
  active change            = NONE
    ← change-management / Agent Control
  protected-service impact = NONE_DETECTED
    ← service / slice impact projection

proposed declared action:
  STEER_TRAFFIC_TO_NEIGHBOR_CELLS

optional supporting action:
  ADJUST_MOBILITY_BIAS
       │
       ▼
L3 — AGENT CONTROL
